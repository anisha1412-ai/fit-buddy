GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model names.
# The project spec uses gemini-1.5-pro / gemini-1.5-flash. If Google has retired
# those models for your key, uncomment and set newer ones, e.g.:
GEMINI_PRO_MODEL=gemini-flash-latest,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
GEMINI_FLASH_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

